# Supabase — valores públicos/cliente
SUPABASE_PROJECT_ID=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Las variantes VITE_* se exponen al cliente durante el build.
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Nexus AI — SOLO servidor (gateway /api/agent → Gemini).
# Nunca uses la variante VITE_ para estas claves: se inyectarían en el bundle
# del cliente. Sin GEMINI_API_KEY el asistente usa el planificador local.
GEMINI_API_KEY=
# Opcional: timeout del gateway en milisegundos (5000–120000, por defecto 45000).
NEXUS_AGENT_TIMEOUT_MS=
